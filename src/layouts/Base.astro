---
import '../styles/global.css';
import CmyMenu from '../components/CmyMenu.astro';
interface Props {
  title: string;
  description?: string;
  image?: string; // social share image (cover); falls back to the default
  accent?: string; // css color for --accent on this page
  crumb?: string; // section name shown as "Hybrid Arts/<crumb>"
  crumbHref?: string; // make the crumb a link (on subpages)
  wide?: boolean; // full-width layout
}
const { title, description, image, accent, crumb, crumbHref, wide } = Astro.props;
const year = new Date().getFullYear();
const SITE = Astro.site ?? new URL('https://hyb.art');
const ogTitle = title === 'Hybrid Arts' ? title : `${title} — Hybrid Arts`;
const desc = description ??
  'Hybrid Arts — Boris Oicherman facilitates multidisciplinary creative collaborations between artists and organizations across sectors.';
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonical = new URL(cleanPath, SITE).href;
const usingDefaultImage = !image;
const ogImage = new URL(image ?? '/images/og-default.jpg', SITE).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'Hybrid Arts' ? title : `${title} — Hybrid Arts`}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hybrid Arts" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {usingDefaultImage && <meta property="og:image:width" content="1200" />}
  {usingDefaultImage && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Google Analytics (GA4) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-15WJM4QZ9P"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-15WJM4QZ9P');
  </script>
</head>
<body style={accent ? `--accent: ${accent}` : undefined}>
  <header class:list={['site', { wide }]}>
    <a class="mark" href="/">Hybrid Arts</a>
    {crumb && (
      <span class="crumb">/{crumbHref ? <a href={crumbHref}>{crumb}</a> : crumb}</span>
    )}
  </header>
  <CmyMenu />

  <main class:list={[{ wide }]}>
    <slot />
  </main>

  <footer class="site">
    <div>
      <a href="/contact">Contact</a><br />
      © {year} Hybrid Arts · Boris Oicherman
    </div>
    <div class="newsletter">
      <form action="https://buttondown.com/api/emails/embed-subscribe/hyb.art" method="post" target="_blank">
        <label for="bd-email">Hybrid Arts newsletter — fresh posts, no more than twice a month</label>
        <div class="row">
          <input type="email" name="email" id="bd-email" placeholder="Email address" required />
          <button type="submit">Sign up</button>
        </div>
      </form>
    </div>
  </footer>

  <script is:inline>
    // Open external links and document downloads in a new tab.
    (function () {
      var here = location.hostname;
      var docExt = /\.(pdf|zip|docx?|pptx?|xlsx?|csv|epub|key)(\?|#|$)/i;
      document.querySelectorAll('a[href]').forEach(function (a) {
        if (a.target) return;
        var href = a.getAttribute('href') || '';
        if (!href || href[0] === '#' || /^(mailto:|tel:)/i.test(href)) return;
        var u;
        try { u = new URL(href, location.href); } catch (e) { return; }
        if (u.protocol !== 'http:' && u.protocol !== 'https:') return;
        var external = u.hostname !== here;
        var isDoc = docExt.test(u.pathname) || u.pathname.indexOf('/files/') === 0;
        if (external || isDoc) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }
      });
    })();
  </script>
</body>
</html>
