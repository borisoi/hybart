---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

// Decide a page's layout from its content:
//  - 'blog'   long text mixed with media -> blog-style essay (marginalia / centered)
//  - 'cols'   several media works        -> 2-column rows, each title beside its media
//  - 'center' a single image/gallery/video (or short text) -> one centered column
function pageMode(body) {
  let units = 0, run = 0, textlen = 0;
  const flush = () => { if (run > 0) units++; run = 0; };
  for (const raw of (body || '').split('\n')) {
    const s = raw.trim();
    if (!s) continue;
    if (/^#{1,6}\s/.test(s)) { flush(); continue; }
    if (/^!\[.*\]\(.*\)\s*$/.test(s)) { run++; continue; }
    if (s.includes('<iframe')) { flush(); units++; continue; }
    flush();
    textlen += s.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[#*_>]/g, '').length;
  }
  flush();
  if (textlen >= 900) return 'blog';
  if (units >= 2) return 'cols';
  return 'center';
}

export async function getStaticPaths() {
  const projects = (await getCollection('art')).sort((a, b) => a.data.order - b.data.order);
  const n = projects.length;
  const label = (x) => x.data.shortTitle ?? x.data.title;
  return projects.map((p, i) => {
    const prevP = i > 0 ? projects[i - 1] : null;
    const nextP = i < n - 1 ? projects[i + 1] : null;
    return {
      params: { id: p.id },
      props: {
        p,
        prev: prevP ? { id: prevP.id, title: label(prevP) } : null,
        next: nextP ? { id: nextP.id, title: label(nextP) } : null,
      },
    };
  });
}

// pull a short plain-text description from the body for SEO / social previews
function metaDesc(body, fallback) {
  for (const raw of (body || '').split('\n')) {
    const s = raw.trim();
    if (!s || /^!\[.*\]\(.*\)\s*$/.test(s) || s.includes('<iframe') || /^#{1,6}\s/.test(s) || /^<[^>]+>$/.test(s)) continue;
    const t = s.replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[#*_>]/g, '').trim();
    if (t.length < 8) continue;
    return t.length > 160 ? t.slice(0, 157).replace(/\s+\S*$/, '') + '…' : t;
  }
  return fallback;
}

const { p, prev, next } = Astro.props;
const { Content } = await render(p);
const year = p.data.tags.find((t) => /^(19|20)\d\d/.test(t));
const mode = pageMode(p.body);
const isGanzfeld = p.id === 'ganzfeld-dot-art';
const description = metaDesc(p.body, `${p.data.title} — a project by Boris Oicherman.`);
---
<Base title={p.data.title} description={description} image={p.data.cover} accent="var(--c-art)" crumb="Art" crumbHref="/art" wide>
  <article class="art-project" data-mode={mode}>
    <p class="meta">
      {year && <span>{year}</span>}
      {p.data.tags.filter((t) => t !== year).map((t) => <span>{t}</span>)}
    </p>
    <h1>{p.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="proj-nav">
    {prev ? (
      <a class="prev" href={`/art/${prev.id}`}>
        <span class="lbl">← Previous project</span>
        <span class="t">{prev.title}</span>
      </a>
    ) : <span class="prev"></span>}
    <a class="all" href="/art">All projects</a>
    {next ? (
      <a class="next" href={`/art/${next.id}`}>
        <span class="lbl">Next project →</span>
        <span class="t">{next.title}</span>
      </a>
    ) : <span class="next"></span>}
  </nav>
  {isGanzfeld && (
    <div id="ganzfeld-overlay" hidden>
      <button id="ganzfeld-close" type="button" aria-label="Exit (Esc)">×</button>
    </div>
  )}
</Base>

<style>
  .art-project .meta { margin: 48px 0 0; display: flex; gap: 14px; flex-wrap: wrap; }
  .art-project .meta span { font-size: 14px; color: var(--muted); }
  .art-project h1 { margin-top: 8px; }
  .art-project :global(.prose img) { border-radius: 22px; margin: 28px 0; }
  .art-project :global(.prose iframe) { width: 100%; max-width: 68ch; aspect-ratio: 16 / 9; height: auto; border-radius: 22px; margin: 28px 0; display: block; }
  .art-project :global(.prose iframe[src*="bandcamp"]) { aspect-ratio: auto; height: 470px; max-width: 420px; }

  /* CENTER: a single image / gallery / video in one centered column */
  .art-project.narrow { max-width: 72ch; margin-inline: auto; }
  .art-project.narrow :global(.prose img) { width: 100%; margin: 28px auto; }
  .art-project.narrow :global(.gal-frame img) { width: auto; max-width: 100%; }
  .art-project.narrow :global(.prose iframe) { margin-inline: auto; }

  /* COLS: per-section rows, each title lined up with its media */
  .art-project :global(.art-sec) { display: grid; grid-template-columns: 65fr 35fr; gap: 44px; align-items: start; margin-top: 52px; }
  .art-project :global(.art-sec.no-media) { display: block; }
  .art-project :global(.col-media .gal),
  .art-project :global(.col-media p),
  .art-project :global(.col-media iframe),
  .art-project :global(.col-media img) { max-width: none; width: 100%; }
  .art-project :global(.col-media .gal-frame img) { width: auto; max-width: 100%; }
  .art-project :global(.col-media > :first-child),
  .art-project :global(.col-text > :first-child) { margin-top: 0; }
  .art-project :global(.col-media > :first-child img) { margin-top: 0; }
  .art-project :global(.col-text) { max-width: 62ch; }

  /* BLOG: long text + media reads like a blog post (text left, media in the margin) */
  .art-project.essay.narrow { max-width: 72ch; margin-inline: auto; }
  .art-project.essay :global(.prose img) { border-radius: 22px; margin: 0 auto 20px; width: 100%; }
  .art-project.essay :global(.prose iframe) { border-radius: 22px; width: 100%; }
  .art-project.essay :global(.prose.cols) { position: relative; }
  .art-project.essay :global(.prose.cols > :not(.rmedia)) { max-width: min(64ch, 55%); }
  .art-project.essay :global(.prose.cols > .rmedia) {
    position: absolute;
    left: calc(min(64ch, 55%) + 52px);
    width: calc(100% - min(64ch, 55%) - 52px);
    margin: 0;
  }
  .art-project.essay :global(.rmedia) { margin: 18px 0; }
  .art-project.essay :global(.prose:not(.cols) .rmedia) { max-width: 68ch; }
  .art-project.essay :global(.rmedia p) { max-width: none; margin: 0 0 14px; }
  .art-project.essay :global(.rmedia iframe) { max-width: none; }
  .art-project.essay :global(.rmedia p.cap) { margin: -8px 4px 24px; color: var(--muted); font-size: 14px; }
  .art-project.essay :global(.prose .gal) { max-width: none; margin: 0 0 20px; }
  .art-project.essay :global(.rmedia p:not(.cap) img) { max-height: 68vh; width: auto; max-width: 100%; }
  .art-project.essay :global(p.pull) {
    font-size: clamp(18px, 1.6vw, 20px); line-height: 1.4; letter-spacing: -0.01em;
    margin: 34px 0; max-width: 36ch; color: var(--c-art);
  }
  .art-project.essay :global(.prose.cols > p.pull) { max-width: min(36ch, 55%); }

  .proj-nav {
    display: flex; justify-content: space-between; align-items: baseline; gap: 24px;
    margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--rule);
  }
  .proj-nav a { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 3px; max-width: 40%; }
  .proj-nav .next { text-align: right; align-items: flex-end; }
  .proj-nav .all { align-self: center; color: var(--muted); font-size: 14px; max-width: none; }
  .proj-nav .all:hover { color: var(--c-art); }
  .proj-nav .lbl { font-size: 13px; color: var(--muted); }
  .proj-nav .t { font-size: 19px; font-weight: 500; letter-spacing: -0.01em; line-height: 1.2; }
  .proj-nav a:hover .t { color: var(--c-art); }
  @media (max-width: 640px) {
    .proj-nav { gap: 16px; }
    .proj-nav .all { display: none; }
    .proj-nav a { max-width: 50%; }
    .proj-nav .t { font-size: 16px; }
  }
  #ganzfeld-overlay { position: fixed; inset: 0; z-index: 9999; background: #000; }
  #ganzfeld-overlay[hidden] { display: none; }
  #ganzfeld-close {
    position: fixed; top: 16px; right: 22px; z-index: 10000;
    background: none; border: 0; padding: 0; line-height: 1;
    font-size: 34px; color: rgba(255, 255, 255, 0.55); cursor: pointer;
    transition: color 0.2s;
  }
  #ganzfeld-close:hover { color: rgba(255, 255, 255, 0.9); }
  @media (max-width: 860px) {
    /* stack each section: title + caption first, then its media */
    .art-project :global(.art-sec) { display: flex; flex-direction: column; gap: 6px; }
    .art-project :global(.art-sec .col-text) { order: 0; }
    .art-project :global(.art-sec .col-media) { order: 1; }
  }
</style>

<script>
  const article = document.querySelector('.art-project');
  const prose = article && article.querySelector('.prose');
  if (prose) {
    const mode = article.dataset.mode || 'center';

    // give each video its true aspect ratio (instead of a forced 16:9), and
    // centre + cap portrait videos so the player keeps all its controls.
    prose.querySelectorAll('iframe').forEach((f) => {
      if (/bandcamp/.test(f.src)) return;
      const w = parseInt(f.getAttribute('width') || '', 10);
      const h = parseInt(f.getAttribute('height') || '', 10);
      if (!w || !h) return;
      f.style.aspectRatio = `${w} / ${h}`;
      if (h > w) {
        f.style.width = 'auto';
        f.style.maxWidth = '100%';
        f.style.height = 'min(78vh, 150vw)';
        f.style.marginInline = 'auto';
      }
    });

    const isHeading = (el) => /^H[1-6]$/.test(el.tagName);
    const isImgP = (el) => {
      if (el.tagName !== 'P') return false;
      let imgs = 0;
      for (const n of el.childNodes) {
        if (n.nodeType === 1 && n.tagName === 'IMG') imgs++;
        else if (n.nodeType === 1 && n.tagName !== 'BR') return false;
        else if (n.nodeType === 3 && n.textContent.trim()) return false;
      }
      return imgs > 0;
    };
    const isMediaEl = (el) => {
      if (el.classList && el.classList.contains('gal')) return true;
      if (el.tagName === 'IFRAME') return true;
      if (el.tagName !== 'P') return false;
      let media = 0;
      for (const n of el.childNodes) {
        if (n.nodeType === 3) { if (n.textContent.trim()) return false; continue; }
        if (n.nodeType !== 1) continue;
        if (n.tagName === 'IMG' || n.tagName === 'IFRAME') media++;
        else if (n.tagName === 'A' && n.children.length === 1 && n.children[0].tagName === 'IMG') media++;
        else if (n.tagName !== 'BR') return false;
      }
      return media > 0;
    };

    // merge consecutive images into an arrow gallery (one media unit)
    let run = [];
    const flush = () => {
      const imgs = run.flatMap((p) => Array.from(p.querySelectorAll('img')));
      if (imgs.length >= 2) {
        const gal = document.createElement('div');
        gal.className = 'gal';
        gal.innerHTML =
          '<div class="gal-frame"></div><div class="gal-nav">' +
          '<button class="gal-prev" aria-label="Previous image">&lsaquo;</button>' +
          '<span class="gal-count"></span>' +
          '<button class="gal-next" aria-label="Next image">&rsaquo;</button></div>';
        run[0].before(gal);
        const frame = gal.querySelector('.gal-frame');
        imgs.forEach((im) => { im.loading = 'lazy'; frame.appendChild(im); });
        run.forEach((p) => p.remove());
        const count = gal.querySelector('.gal-count');
        let idx = 0;
        const show = (i) => {
          idx = (i + imgs.length) % imgs.length;
          imgs.forEach((im, k) => im.classList.toggle('on', k === idx));
          count.textContent = `${idx + 1} / ${imgs.length}`;
        };
        gal.querySelector('.gal-prev').addEventListener('click', () => show(idx - 1));
        gal.querySelector('.gal-next').addEventListener('click', () => show(idx + 1));
        show(0);
      }
      run = [];
    };
    for (const el of Array.from(prose.children)) {
      if (isImgP(el)) run.push(el); else flush();
    }
    flush();

    if (mode === 'blog') blogLayout();
    else if (mode === 'cols') colsLayout();
    else article.classList.add('narrow');

    setupLightbox();

    // --- COLS: one row per media unit; title + caption beside the media, tops aligned ---
    function colsLayout() {
      const kids = Array.from(prose.children);
      const rows = [];
      let cur = null;
      const preamble = [];
      for (const el of kids) {
        if (isHeading(el)) { cur = { title: el, items: [], media: [] }; rows.push(cur); continue; }
        if (isMediaEl(el)) {
          if (!cur || cur.media.length) { cur = { title: null, items: [], media: [] }; rows.push(cur); }
          cur.media.push(el); continue;
        }
        if (cur) cur.items.push(el); else preamble.push(el);
      }
      for (const r of rows) {
        const row = document.createElement('div');
        if (r.media.length) {
          row.className = 'art-sec';
          const media = document.createElement('div'); media.className = 'col-media';
          const text = document.createElement('div'); text.className = 'col-text';
          if (r.title) text.appendChild(r.title);
          for (const el of r.items) text.appendChild(el);
          for (const el of r.media) media.appendChild(el);
          row.append(media, text);
        } else {
          row.className = 'art-sec no-media';
          if (r.title) row.appendChild(r.title);
          for (const el of r.items) row.appendChild(el);
        }
        prose.appendChild(row);
      }
    }

    // --- BLOG: marginalia layout (text flows left, media floats in the right margin) ---
    function blogLayout() {
      article.classList.add('essay');
      const onlyChild = (el, tag) =>
        el.tagName === 'P' &&
        el.children.length === 1 &&
        el.children[0].tagName === tag &&
        Array.from(el.childNodes).every((n) => n.nodeType !== 3 || !n.textContent.trim());
      const isCaption = (el) => onlyChild(el, 'SMALL');
      for (const el of Array.from(prose.children)) {
        if (onlyChild(el, 'EM')) el.classList.add('pull');
      }
      const groups = [];
      let curMedia = null;
      let chunkStart = null;
      for (const el of Array.from(prose.children)) {
        if (isMediaEl(el)) {
          if (!curMedia) { curMedia = { els: [], anchor: chunkStart }; groups.push(curMedia); }
          curMedia.els.push(el);
        } else if (isCaption(el) && curMedia) {
          el.classList.add('cap');
          curMedia.els.push(el);
        } else {
          if (curMedia) { curMedia = null; chunkStart = null; }
          if (!chunkStart) chunkStart = el;
        }
      }
      for (const g of groups) {
        const wrap = document.createElement('div');
        wrap.className = 'rmedia';
        g.els[0].before(wrap);
        g.els.forEach((el) => wrap.appendChild(el));
        g.el = wrap;
      }
      article.classList.toggle('narrow', groups.length < 3);
      const place = () => {
        if (!groups.length) return;
        if (groups.length < 3 || window.matchMedia('(max-width: 860px)').matches) {
          prose.classList.remove('cols');
          groups.forEach((g) => { g.el.style.top = ''; });
          prose.style.minHeight = '';
          return;
        }
        prose.classList.add('cols');
        let prevBottom = 0;
        for (const g of groups) {
          const top = Math.max(g.anchor ? g.anchor.offsetTop : 0, prevBottom);
          g.el.style.top = top + 'px';
          prevBottom = top + g.el.offsetHeight + 36;
        }
        prose.style.minHeight = prevBottom - 36 + 'px';
      };
      let raf = 0;
      const schedule = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(place); };
      const ro = new ResizeObserver(schedule);
      ro.observe(prose);
      groups.forEach((g) => ro.observe(g.el));
      window.addEventListener('resize', schedule);
      prose.querySelectorAll('img').forEach((im) => {
        if (!im.complete) im.addEventListener('load', schedule, { once: true });
      });
      schedule();
    }

    // --- lightbox for images (not linked images, not videos) ---
    function setupLightbox() {
      const zoomables = Array.from(prose.querySelectorAll('img')).filter((im) => !im.closest('a'));
      if (!zoomables.length) return;
      const box = document.createElement('div');
      box.className = 'lightbox';
      box.hidden = true;
      box.innerHTML =
        '<button class="lb-prev" aria-label="Previous image">&lsaquo;</button>' +
        '<img alt="" />' +
        '<button class="lb-next" aria-label="Next image">&rsaquo;</button>';
      document.body.appendChild(box);
      const boxImg = box.querySelector('img');
      let lbIdx = 0;
      const lbShow = (i) => {
        lbIdx = (i + zoomables.length) % zoomables.length;
        boxImg.src = zoomables[lbIdx].src;
      };
      const close = () => { box.hidden = true; document.body.style.overflow = ''; };
      box.addEventListener('click', close);
      box.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); lbShow(lbIdx - 1); });
      box.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); lbShow(lbIdx + 1); });
      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') lbShow(lbIdx - 1);
        if (e.key === 'ArrowRight') lbShow(lbIdx + 1);
      });
      if (zoomables.length < 2) box.classList.add('lb-single');
      zoomables.forEach((im, i) => {
        im.classList.add('zoomable');
        im.addEventListener('click', () => {
          lbShow(i);
          box.hidden = false;
          document.body.style.overflow = 'hidden';
        });
      });
    }
  }
</script>

<script>
  // ganzfeld.art simulation — original by Boris Oicherman, 2020.
  // Slowly cycles a fullscreen overlay through saturated hues.
  const overlay = document.getElementById('ganzfeld-overlay');
  if (overlay) {
    const cycleDuration = 40; // seconds per cycle
    const fps = 25;
    const interval = 1000 / fps;
    const startH = 315, S = 100, L = 50, arc = 45;

    const hsl2rgb = (h, s, l) => {
      s /= 100; l /= 100;
      const c = (1 - Math.abs(2 * l - 1)) * s;
      const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
      const m = l - c / 2;
      let r = 0, g = 0, b = 0;
      if (h < 60) { r = c; g = x; }
      else if (h < 120) { r = x; g = c; }
      else if (h < 180) { g = c; b = x; }
      else if (h < 240) { g = x; b = c; }
      else if (h < 300) { r = x; b = c; }
      else { r = c; b = x; }
      return [
        Math.round((r + m) * 255),
        Math.round((g + m) * 255),
        Math.round((b + m) * 255),
      ];
    };

    // Precompute the hue arc, then mirror it so colour returns to start (cycle).
    const size = cycleDuration * fps;
    const step = arc / size;
    let frames = [];
    for (let i = 0; i < size; i++) frames.push(hsl2rgb((startH + i * step) % 360, S, L));
    frames = frames.concat(frames.slice().reverse());

    let idx = 0;
    let timer = null;
    const paint = () => {
      const [r, g, b] = frames[idx];
      overlay.style.backgroundColor = `rgb(${r},${g},${b})`;
      idx = (idx + 1) % frames.length;
    };
    const open = () => {
      idx = 0;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      paint();
      timer = setInterval(paint, interval);
    };
    const close = () => {
      if (timer) { clearInterval(timer); timer = null; }
      overlay.hidden = true;
      document.body.style.overflow = '';
    };

    document.querySelectorAll('a[href$="#ganzfeld"]').forEach((a) =>
      a.addEventListener('click', (e) => { e.preventDefault(); open(); })
    );
    document.getElementById('ganzfeld-close')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (!overlay.hidden && e.key === 'Escape') close();
    });
  }
</script>
